# HUGO environment. Everything is optional: HUGO runs with no keys at all.
HUGO_LOCAL_AI_ENDPOINT=
HUGO_LOCAL_AI_MODEL=local-model
# HUGO_LOCAL_AI_ENDPOINT can be http://127.0.0.1:11434 for Ollama or an OpenAI-compatible local server.
OLLAMA_ENDPOINT=
OLLAMA_MODEL=llama3.2
HUGO_VISION_ENDPOINT=
HUGO_CHROME_PORT=9222
HUGO_CHROME_BIN=
HUGO_CHROME_PROFILE=
HUGO_CHROME_PROFILE_MODE=copy
HUGO_DEVICE_TOKEN=
HUGO_UI_PORT=8765
HUGO_GATEWAY_PORT=8787
HUGO_REPO=
HUGO_BRANCH=main
HUGO_MEMORY_AUTO_PUSH=true
HUGO_MEMORY_SYNC_INTERVAL_MS=900000
HUGO_RETENTION_DAYS=90
HUGO_TZ=Europe/Skopje
HUGO_VOICE_LANG=mk-MK
HUGO_LOG_LEVEL=info
