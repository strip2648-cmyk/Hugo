    "test": "node scripts/tests/run-all.js",
    "test:live": "node scripts/tests/run-all.js --live",
    "tools": "node scripts/cli/hugo.js tools",
    "tools:audit": "node scripts/cli/hugo.js tools:audit",
    "agents": "node scripts/cli/hugo.js agents",
    "memory:recall": "node scripts/cli/hugo.js memory:recall",
    "memory:stats": "node scripts/cli/hugo.js memory:stats",
    "memory:export": "node scripts/cli/hugo.js memory:export",
    "memory:import": "node scripts/cli/hugo.js memory:import",
    "memory:sync": "node scripts/cli/hugo.js memory:sync",
    "memory:prune": "node scripts/cli/hugo.js memory:prune",
    "ui": "node scripts/cli/hugo.js ui",
    "gateway": "node scripts/cli/hugo.js gateway",
