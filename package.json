    "jarvis": "node scripts/cli/hugo.js jarvis",
    "exec": "node scripts/cli/hugo.js exec",
    "host": "node scripts/cli/hugo.js host",
    "files": "node scripts/cli/hugo.js files",
    "sites": "node scripts/cli/hugo.js sites",
    "confirm": "node scripts/cli/hugo.js confirm",
    "registry:sync": "node scripts/cli/hugo.js registry:sync",
